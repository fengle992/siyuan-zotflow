    "obsidian",
    "sync",
    "markdown"
  ],
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.0",
    "siyuan": "^1.2.6",
    "typescript": "^5.8.3"
  }
}
