{
  "name": "siyuan-zotflow",
  "version": "0.5.0",
  "description": "Sync Obsidian ZotFlow literature notes into SiYuan with incremental sync and block-ID preservation",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint ."
  },
  "keywords": [
